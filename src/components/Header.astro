---
import { SITE, url } from "../lib/site";
const path = Astro.url.pathname;
const links = [
  { href: url("/"), label: "Today", match: (p: string) => p === url("/") },
  { href: url("/learn/"), label: "Learn", match: (p: string) => p.startsWith(url("/learn")) },
  { href: url("/archive/"), label: "Archive", match: (p: string) => p.startsWith(url("/archive")) },
  { href: url("/about/"), label: "About", match: (p: string) => p.startsWith(url("/about")), cls: "hide-sm" },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url("/")} aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M2 12h3l3-8 4 16 3-8h7"/></svg>
      </span>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class={l.cls} aria-current={l.match(path) ? "page" : undefined}>{l.label}</a>)}
      <a class="icon-btn hide-sm" href={url("/rss.xml")} aria-label="RSS feed" title="RSS feed">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.2" fill="currentColor"/></svg>
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const sync = () => {
    if (!root.dataset.theme) root.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  sync();
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
    document.dispatchEvent(new CustomEvent("themechange"));
  });
</script>
