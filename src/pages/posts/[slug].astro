---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import Signal from "../../components/Signal.astro";
import ArticleEnhancements from "../../components/ArticleEnhancements.astro";
import { getPosts, url, formatDate, readingMinutes, slugify, inlineMd, dayKey, type Post } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1],
      older: posts[i + 1],
      sameDay: posts.filter((p) => p.id !== post.id && dayKey(p.data.date) === dayKey(post.data.date)),
    },
  }));
}

const { post, newer, older, sameDay } = Astro.props as { post: Post; newer?: Post; older?: Post; sameDay: Post[] };
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={d.title} description={d.summary} type="article">
  <ArticleEnhancements />
  <div class="container">
    <div class:list={["article-wrap", { "has-rail": sameDay.length > 0 }]}>
      {sameDay.length > 0 && (
        <aside class="rail" aria-label="More from this day">
          <h2>Also on {formatDate(d.date, { month: "short", day: "numeric" })}</h2>
          <ul>
            {sameDay.map((p) => (
              <li><a href={url(`/posts/${p.id}/`)}>
                <CategoryBadge category={p.data.category} />
                <span class="t">{p.data.title}</span>
                <span class="s">{p.data.source.name} · {readingMinutes(p.body)} min</span>
              </a></li>
            ))}
          </ul>
        </aside>
      )}
      <article>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={url("/")}>Today</a><span aria-hidden="true">/</span>
          <a href={url(`/category/${slugify(d.category)}/`)}>{d.category}</a>
        </nav>
        <header class="article-head">
          <div class="card-top" style="justify-content:flex-start;gap:12px"><CategoryBadge category={d.category} /><Signal level={d.importance} /></div>
          <h1>{d.title}</h1>
          <p class="lede">{d.summary}</p>
          <div class="meta">
            <time datetime={d.date.toISOString()}>{formatDate(d.date, { month: "long", day: "numeric", year: "numeric" })}</time>
            <span class="sep" /><span>{readingMinutes(post.body)} min read</span>
            <span class="sep" /><span>via <a href={d.source.url} rel="noopener" target="_blank" style="text-decoration:underline;text-underline-offset:3px">{d.source.name}</a></span>
          </div>
        </header>

        {d.takeaways.length > 0 && (
          <section class="takeaways" aria-labelledby="kt">
            <h2 id="kt">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              Key takeaways
            </h2>
            <ol>{d.takeaways.map((t) => <li><span set:html={inlineMd(t)} /></li>)}</ol>
          </section>
        )}

        <div class="prose"><Content /></div>

        <aside class="source-card">
          <div>
            <div class="label">Original source · {d.source.name}</div>
            <div class="title">{d.source.title ?? d.title}</div>
          </div>
          <a class="btn primary" href={d.source.url} target="_blank" rel="noopener">Read the original ↗</a>
        </aside>
        <p class="note">
          {d.sample
            ? "This is a sample post that shows the format. Daily posts are generated from the source above."
            : `This analysis was written with AI assistance${d.writer ? ` (${d.writer})` : ""} from the original source. Always check the original for critical decisions.`}
        </p>

        {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">#{t}</span>)}</div>}

        <nav class="pager" aria-label="More posts">
          {older ? <a href={url(`/posts/${older.id}/`)}><div class="dir">← Older</div><div class="t">{older.data.title}</div></a> : <span />}
          {newer && <a class="next" href={url(`/posts/${newer.id}/`)}><div class="dir">Newer →</div><div class="t">{newer.data.title}</div></a>}
        </nav>
      </article>

      {toc.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <h2>On this page</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
        </aside>
      )}
    </div>
  </div>
</Base>

